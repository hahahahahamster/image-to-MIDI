+  function validateSettings() {
+    const values = {
+      width: Number(widthNotes.value),
+      height: Number(heightNotes.value),
+      start: Number(startNote.value),
+      tempo: Number(tempo.value),
+      threshold: Number(threshold.value),
+      background: background.value
